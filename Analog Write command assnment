int redPin = 9;
int dim = 5;
int inter = 60;
int bright =255;
int del = 5000;

void setup() {
  // put your setup code here, to run once:
pinMode(redPin, OUTPUT);
}

void loop() {
  // put your main code here, to run repeatedly:
analogWrite(redPin, dim);
delay(del);
analogWrite(redPin, inter);
delay(del);
analogWrite(redPin, bright);
delay(del);
}
