void setup() {
  // put your setup code here, to run once:
  pinMode(13, OUTPUT);
  pinMode(10, OUTPUT);
  pinMode(3, OUTPUT);
}

void loop() {
  // put your main code here, to run repeatedly:
  digitalWrite(13, HIGH);
  delay(400);
  digitalWrite(13, LOW);
  delay(200);

  digitalWrite(10, HIGH);
  delay(200);
  digitalWrite(10, LOW);
  delay(100);

  digitalWrite(3, HIGH);
  delay(100);
  digitalWrite(3, LOW);
  delay(50);
}
