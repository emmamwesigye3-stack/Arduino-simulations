// C++ code
int buzzPin = 10;
int readPin = A3;
int potVal;
int toneVal;

void setup(){
  pinMode(buzzPin, OUTPUT);
  pinMode(readPin, INPUT);
  Serial.begin(9600);
}

void loop()
{
  potVal = analogRead(readPin);
  Serial.println(potVal);
  delay(1000);
  toneVal  = (9940. / 1023.) *  potVal + 60.;
  
  digitalWrite(buzzPin, HIGH);
  delayMicroseconds(toneVal);
  digitalWrite(buzzPin, LOW);
  delayMicroseconds(toneVal);
  
}
